{
    "name": "shallot-site",
    "version": "0.9.5",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.2",
    "scripts": {
        "engine": "bun run scripts/engine-checkout.ts",
        "build": "bun run scripts/build-site.ts",
        "sourcemaps:prepare": "bun run scripts/prepare-sourcemaps.ts",
        "pages": "bun run scripts/build-pages.ts",
        "demos": "bun run scripts/demos.ts",
        "candidate": "bun run engine --candidate",
        "list": "shallot test --list",
        "check": "tsc --noEmit && biome check && shallot test --list",
        "test": "shallot test"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@datadog/datadog-ci": "5.24.0",
        "@dylanebert/shallot": "github:dylanebert/shallot#69f12a06438d8ce80aa1ab9e4b34de5b58820e15",
        "@types/bun": "latest",
        "@types/node": "^26.0.0",
        "playwright": "^1.63.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "wrangler": "4.35.0"
    }
}
