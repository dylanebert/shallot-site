{
    "name": "shallot-site",
    "version": "0.9.5",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.2",
    "scripts": {
        "engine": "bun run scripts/engine-checkout.ts",
        "build": "bun run scripts/build-site.ts",
        "pages": "bun run scripts/build-pages.ts",
        "demos": "bun run scripts/demos.ts",
        "candidate": "bun run engine --candidate",
        "list": "shallot list",
        "workflow": "shallot workflow",
        "check": "tsc --noEmit && biome check && shallot check",
        "test": "bun run scripts/test.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@dylanebert/shallot": "github:dylanebert/shallot#70770cfc34d82fdd19cb705d8753bb6f093748d6",
        "@types/bun": "latest",
        "playwright": "^1.63.0",
        "typescript": "^7.0.2"
    }
}
